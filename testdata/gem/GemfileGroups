source "https://rubygems.org"

gem "rake"

group :development do
  gem "rubocop"
end

group :test do
  gem "minitest"
end

group :prof, optional: true do
  gem "ruby-prof"
end

group :extra, :optional => true do
  gem "stackprof"
end

group :ci, optional: false do
  gem "simplecov"
end

gem "yard", group: :development
gem "webmock", "~> 3.0", :group => :test
gem "listen", groups: [:development, :test]
gem "irb", group: :repl
